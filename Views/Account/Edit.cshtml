@model NettruyenRemake.Models.User

@{
    ViewData["Title"] = "Edit Account";
    var roles = ViewBag.Roles as List<NettruyenRemake.Models.Role>;
}

<div class="container mt-4">
    <h1>Edit Account</h1>

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Edit User Details</h4>
        </div>
        <div class="card-body">
            <form asp-controller="Account" asp-action="Edit" asp-route-id="@Model.UserId" method="post">

                <div class="row mb-3">
                    <div class="col-md-3 text-center">
                        @if (Model.Avatar != null)
                        {
                            <img src="data:image/png;base64,@Convert.ToBase64String(Model.Avatar)" class="img-thumbnail rounded-circle" style="width: 150px; height: 150px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 150px; height: 150px; margin: 0 auto;">
                                <i class="fas fa-user fa-4x"></i>
                            </div>
                        }
                    </div>
                    <div class="col-md-9">
                        <div class="form-group mb-3">
                            <label for="Username" class="form-label">Username</label>
                            <input name="Username" id="Username" value="@Model.Username" class="form-control" required />
                            <span class="text-danger">@Html.ValidationMessage("Username")</span>
                        </div>

                        <div class="form-group mb-3">
                            <label for="Email" class="form-label">Email</label>
                            <input name="Email" id="Email" value="@Model.Email" class="form-control" type="email" required />
                            <span class="text-danger">@Html.ValidationMessage("Email")</span>
                        </div>

                        <div class="form-group mb-3">
                            <label for="newPassword" class="form-label">New Password (optional)</label>
                            <input name="newPassword" id="newPassword" class="form-control" type="password" placeholder="Leave blank to keep current password" />
                            <span class="text-danger">@Html.ValidationMessage("newPassword")</span>
                        </div>

                        <div class="form-group mb-3">
                            <label for="RoleId" class="form-label">Role</label>
                            <select name="RoleId" id="RoleId" class="form-select" required>
                                <option value="">Select a role</option>
                                @foreach (var role in roles)
                                {
                                    if (Model.RoleId == role.RoleId)
                                    {
                                        <option value="@role.RoleId" selected>@role.RoleName</option>
                                    }
                                    else
                                    {
                                        <option value="@role.RoleId">@role.RoleName</option>
                                    }
                                }
                            </select>
                            <span class="text-danger">@Html.ValidationMessage("RoleId")</span>
                        </div>
                    </div>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}