@model NettruyenRemake.Models.User

@{
    ViewData["Title"] = "Delete Account";
}

<div class="container mt-4">
    <h1>Delete Account</h1>

    <div class="card shadow-sm mt-4 border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Confirm Deletion</h4>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i> 
                Are you sure you want to delete this account? This action cannot be undone.
            </div>

            <dl class="row mt-4">
                <dt class="col-sm-3">User ID</dt>
                <dd class="col-sm-9">@Model.UserId</dd>

                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">@Model.Username</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Role</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.RoleId == 3 ? "bg-danger" : Model.RoleId == 2 ? "bg-warning" : "bg-info")">
                        @Model.Role.RoleName
                    </span>
                </dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString()</dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-4">
                <input type="hidden" asp-for="UserId" />
                <button type="submit" class="btn btn-danger">Delete Account</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div> 