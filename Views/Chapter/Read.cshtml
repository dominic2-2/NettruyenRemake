@model NettruyenRemake.Models.Chapter
@{
    ViewData["Title"] = $"{Model.Comic.Title} - Chapter {Model.ChapterNumber}";
    var images = ViewBag.Images as List<string> ?? new();
}

<!-- Override layout chỉ cho trang này -->
<style>
    .chapter-reader-container {
        max-width: 100vw;
        padding: 0;
        margin: 0 auto;
    }
</style>

<div class="chapter-reader-container">
    <!-- Thanh tiêu đề + điều hướng chương -->
    <div class="sticky top-0 bg-white shadow z-50 px-4 py-3 flex flex-wrap justify-between items-center">
        <div>
            @if (ViewBag.PreviousChapter != null)
            {
                <a href="@Url.Action("Read", "Chapter", new { id = ViewBag.PreviousChapter.ChapterId })"
                   class="text-sm bg-gray-200 hover:bg-gray-300 text-gray-800 py-2 px-3 rounded mr-2">
                    ← Chapter @ViewBag.PreviousChapter.ChapterNumber
                </a>
            }
        </div>

        <div class="relative">
            <select onchange="location.href=this.value"
                    class="text-sm border rounded px-3 py-2 focus:outline-none">
                @foreach (var chap in ViewBag.ChapterList as List<Chapter>)
                {
                    if (chap.ChapterId == Model.ChapterId)
                    {
                        <option selected="selected" value="@Url.Action("Read", "Chapter", new { id = chap.ChapterId })">
                            Chapter @chap.ChapterNumber
                        </option>
                    }
                    else
                    {
                        <option value="@Url.Action("Read", "Chapter", new { id = chap.ChapterId })">
                            Chapter @chap.ChapterNumber
                        </option>
                    }
                }

            </select>
        </div>

        <div>
            @if (ViewBag.NextChapter != null)
            {
                <a href="@Url.Action("Read", "Chapter", new { id = ViewBag.NextChapter.ChapterId })"
                   class="text-sm bg-gray-200 hover:bg-gray-300 text-gray-800 py-2 px-3 rounded ml-2">
                    Chapter @ViewBag.NextChapter.ChapterNumber →
                </a>
            }
        </div>
    </div>

    <!-- Ảnh truyện -->
    <div class="flex flex-col items-center gap-4 px-2">
        @foreach (var img in images)
        {
            <img src="@Url.Action("ProxyImage", "Comic", new { url = img })"
                 alt="Page"
                 class="max-w-full w-auto object-contain"
                 style="max-height: none;"
                 onerror="this.src='/images/default-page.jpg'" />
        }
    </div>

    <div class="mt-6 text-center pb-10">
        <a href="@Url.Action("Details", "Comic", new { id = Model.ComicId })"
           class="text-indigo-600 hover:underline">
            ← Quay về trang truyện
        </a>
    </div>
</div>
