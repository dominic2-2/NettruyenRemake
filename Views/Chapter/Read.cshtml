@model NettruyenRemake.Models.Chapter

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đọc Chapter @Model.ChapterNumber - @Model.Comic.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 font-sans">
    <div class="container mx-auto p-4">
        <h1 class="text-2xl font-bold mb-4">Đọc Chapter @Model.ChapterNumber - @Model.Comic.Title</h1>
        <div class="bg-white shadow-md rounded-lg p-6">
            <h2 class="text-xl font-semibold mb-2">@(string.IsNullOrEmpty(Model.Title) ? $"Chapter {Model.ChapterNumber}" : Model.Title)</h2>
            <div class="prose max-w-none">
                @Html.Raw(Model.Content)
            </div>
        </div>
    </div>
</body>
</html>