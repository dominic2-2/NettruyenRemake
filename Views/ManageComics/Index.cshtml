@model IEnumerable<NettruyenRemake.Models.Comic>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<p><a href="/ManageComics/Create">Create New</a></p>

<!-- Container rỗng, partial sẽ được load qua Ajax -->
<div id="comicsContainer"></div>

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        function loadPage(page) {
            $.ajax({
                url: '/ManageComics/LoadComicsPartial',
                type: 'GET',
                data: { page: page, pageSize: 1 }, // Test pageSize=1
                success: function (data) {
                    $('#comicsContainer').html(data);
                },
                error: function () {
                    alert('Error loading page');
                }
            });
        }

        $(document).ready(function() {
            // Gọi Ajax load page 1 ngay khi trang vừa mở
            loadPage(1);
        });
    </script>
}
