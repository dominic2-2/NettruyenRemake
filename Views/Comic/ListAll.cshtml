@model IEnumerable<NettruyenRemake.Models.Comic>

@{
    ViewData["Title"] = "All Comics";
    var followedComicIds = ViewBag.FollowedComicIds as List<int> ?? new List<int>();
    var userId = Context.Session.GetInt32("UserId");
    bool isLoggedIn = userId.HasValue && userId.Value > 0;
}

<div class="container mx-auto px-4 py-8">
    <form method="get" class="mb-6 flex flex-wrap gap-4 items-center bg-white p-4 rounded-lg shadow-sm">
        <input type="hidden" name="keyword" value="@ViewBag.Keyword" />

        <!-- Sắp xếp -->
        <div class="flex items-center gap-2">
            <label class="text-sm font-medium text-gray-700 whitespace-nowrap">Sắp xếp:</label>
            <select name="sort" class="w-full max-w-[180px] border border-gray-300 rounded-md px-3 py-2 text-sm text-gray-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                <option value="newest" selected="@(ViewBag.Sort == "newest")">🕒 Mới đăng</option>
                <option value="views" selected="@(ViewBag.Sort == "views")">👁️ Lượt đọc</option>
                <option value="likes" selected="@(ViewBag.Sort == "likes")">❤️ Lượt thích</option>
                <option value="recent" selected="@(ViewBag.Sort == "recent")">🆕 Mới cập nhật chương</option>
            </select>
        </div>

        

        <!-- Thể loại -->
        <div class="flex items-center gap-2 flex-1 min-w-[300px]">
            <label class="text-sm font-medium text-gray-700 whitespace-nowrap">Thể loại:</label>
            <select id="categorySelect" name="categoryIds" multiple="multiple"
                    class="w-full border border-gray-300 rounded-md text-sm text-gray-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                @foreach (var cat in ViewBag.Categories as List<NettruyenRemake.Models.Category>)
                {
                    var selectedCategories = ViewBag.SelectedCategoryIds as List<int> ?? new List<int>();
                    <option value="@cat.CategoryId" selected="@(selectedCategories.Contains(cat.CategoryId) ? "selected" : null)">
                        @cat.CategoryName
                    </option>
                }
            </select>
        </div>

        <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-md text-sm font-medium hover:bg-indigo-700 transition duration-200">
            Lọc
        </button>
    </form>

    <!-- Main Content -->
    <div class="mt-8">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-900">Browse Comics</h1>
        </div>

        <!-- Danh sách truyện -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            @foreach (var comic in Model)
            {
                bool isFollowing = followedComicIds.Contains(comic.ComicId);
                <div class="bg-white rounded-lg overflow-hidden shadow-md transition-transform hover:scale-105 hover:shadow-lg">
                    <a href="@Url.Action("Details", "Comic", new { id = comic.ComicId })" class="block">
                        <img src="@(string.IsNullOrEmpty(comic.ThumbnailUrl) ? "/images/default-comic.jpg" :
                            (comic.ThumbnailUrl.StartsWith("http")
                                ? Url.Action("GetComicImage", "Comic", new { url = comic.ThumbnailUrl })
                                : comic.ThumbnailUrl))"
                             class="w-full h-64 object-cover"
                             alt="@comic.Title" />
                    </a>

                    <div class="p-4">
                        <a href="@Url.Action("Details", "Comic", new { id = comic.ComicId })" class="block">
                            <h3 class="text-xl font-bold mb-2 text-gray-900 hover:text-indigo-600 transition-colors line-clamp-2">
                                @comic.Title
                            </h3>
                        </a>

                        <div class="flex items-center justify-between text-gray-600 text-sm mb-3">
                            <span class="flex items-center gap-1">
                                <i class="fas fa-eye"></i>
                                <span>@(comic.ComicStat?.ViewCount?.ToString("N0") ?? "0")</span>
                            </span>
                            <span class="flex items-center gap-1">
                                <i class="fas fa-comment"></i>
                                <span>@(comic.ComicStat?.CommentCount?.ToString("N0") ?? "0")</span>
                            </span>
                            <span class="flex items-center gap-1 text-pink-500">
                                <i class="fas fa-heart"></i>
                                <span>@(comic.ComicStat?.FollowCount?.ToString("N0") ?? "0")</span>
                            </span>
                            <span class="flex items-center gap-1 text-yellow-500">
                                <i class="fas fa-star"></i>
                                <span>@(ViewBag.ComicRatings[comic.ComicId])</span>
                            </span>
                        </div>

                        <div class="border-t border-gray-200 pt-3">
                            @{
                                var chapters = comic.Chapters?.OrderByDescending(c => c.ChapterNumber).Take(3).ToList() ?? new List<Chapter>();
                            }
                            @if (chapters.Any())
                            {
                                <div class="space-y-2">
                                    @foreach (var chapter in chapters)
                                    {
                                        <a href="@Url.Action("Read", "Chapter", new { id = chapter.ChapterId })"
                                           class="flex justify-between items-center hover:bg-gray-50 px-2 py-1 rounded-md transition-colors text-sm">
                                            <span class="text-gray-900">Chapter @chapter.ChapterNumber</span>
                                            @if (chapter.CreatedAt.HasValue)
                                            {
                                                TimeSpan timeAgo = DateTime.Now - chapter.CreatedAt.Value;
                                                string timeText = timeAgo.TotalMinutes < 60 ? $"{(int)timeAgo.TotalMinutes} min ago" :
                                                timeAgo.TotalHours < 24 ? $"{(int)timeAgo.TotalHours} hours ago" :
                                                $"{(int)timeAgo.TotalDays} days ago";
                                                <span class="text-gray-500 text-xs">@timeText</span>
                                            }
                                        </a>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-gray-500 text-center py-2 text-sm">No chapters yet</p>
                            }
                        </div>
                    </div>

                    @if (isLoggedIn)
                    {
                        <div class="px-4 pb-4">
                            <button class="follow-toggle-btn w-full py-2 rounded-md text-sm font-medium transition-colors @(isFollowing ? "bg-pink-100 text-pink-700 hover:bg-pink-200" : "bg-gray-100 text-gray-700 hover:bg-gray-200")"
                                    data-comic-id="@comic.ComicId"
                                    data-following="@isFollowing.ToString().ToLower()">
                                <i class="fas fa-heart mr-2"></i>
                                @(isFollowing ? "Following" : "Follow")
                            </button>
                        </div>
                    }
                </div>
            }
        </div> <!-- Kết thúc grid -->
        <!-- Phân trang -->
        @if ((int)ViewBag.TotalPages > 1)
        {
            <div class="mt-10 flex justify-center gap-2 flex-wrap">
                @{
                    var selectedCategoryIds = ViewBag.SelectedCategoryIds as List<int> ?? new List<int>();
                    var updatedWithin = ViewBag.UpdatedWithin as string ?? "";
                }
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    var query = $"?keyword={ViewBag.Keyword}&sort={ViewBag.Sort}&updatedWithin={updatedWithin}&page={i}";
                    foreach (var catId in selectedCategoryIds)
                    {
                        query += $"&categoryIds={catId}";
                    }

                    <a href="@Url.Action("ListAll", "Comic")@query"
                       class="px-4 py-2 rounded-md border text-sm font-medium transition-all duration-200 @(i == ViewBag.CurrentPage ? "bg-indigo-600 text-white" : "bg-white text-gray-700 hover:bg-gray-100")">
                        @i
                    </a>
                }
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Khởi tạo Select2 với giao diện Tailwind
            $('#categorySelect').select2({
                placeholder: 'Chọn thể loại hoặc thêm mới',
                allowClear: true,
                tags: true,
                tokenSeparators: [',', ' '],
                dropdownCssClass: 'max-h-64', // Giới hạn chiều cao dropdown
                selectionCssClass: 'w-full border-gray-300 rounded-md text-sm',
                templateResult: function(data) {
                    return $('<span class="text-gray-800 text-sm px-2 py-1">' + data.text + '</span>');
                },
                templateSelection: function(data) {
                    return $('<span class="text-gray-800 text-sm">' + data.text + '</span>');
                },
                createTag: function(params) {
                    var term = $.trim(params.term);
                    if (term === '') return null;
                    return { id: term, text: term, newTag: true };
                },
                insertTag: function(data, tag) {
                    data.push(tag);
                }
            }).on('select2:open', function() {
                // Tùy chỉnh dropdown khi mở
                $('.select2-dropdown').addClass('border border-gray-300 rounded-md bg-white shadow-lg');
                $('.select2-search__field').addClass('w-full px-2 py-1 text-sm border-b border-gray-200 focus:outline-none focus:ring-0');
            });

            // Xử lý toggle follow
            $('.follow-toggle-btn').click(function() {
                var btn = $(this);
                var comicId = btn.data('comic-id');

                $.ajax({
                    url: '@Url.Action("ToggleFollow", "Comic")',
                    type: 'POST',
                    data: { comicId: comicId },
                    success: function(response) {
                        if (response.success) {
                            var statElement = btn.closest('.bg-white').find('.text-pink-500 span');
                            var currentCount = parseInt(statElement.text().replace(/,/g, ''));

                            if (response.following) {
                                btn.html('<i class="fas fa-heart mr-2"></i> Following')
                                    .removeClass('bg-gray-100 text-gray-700 hover:bg-gray-200')
                                    .addClass('bg-pink-100 text-pink-700 hover:bg-pink-200')
                                    .data('following', 'true');
                                statElement.text((currentCount + 1).toLocaleString());
                            } else {
                                btn.html('<i class="fas fa-heart mr-2"></i> Follow')
                                    .removeClass('bg-pink-100 text-pink-700 hover:bg-pink-200')
                                    .addClass('bg-gray-100 text-gray-700 hover:bg-gray-200')
                                    .data('following', 'false');
                                statElement.text((Math.max(0, currentCount - 1)).toLocaleString());
                            }
                        } else {
                            alert(response.message || 'Failed to update follow status.');
                        }
                    },
                    error: function() {
                        alert('Failed to update follow status. Please try again.');
                    }
                });
            });
        });
    </script>
}