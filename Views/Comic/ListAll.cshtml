@model IEnumerable<NettruyenRemake.Models.Comic>

@{
    ViewData["Title"] = "All Comics";
    var followedComicIds = ViewBag.FollowedComicIds as List<int> ?? new List<int>();

    // Check if user is logged in using session
    var userId = Context.Session.GetInt32("UserId");
    bool isLoggedIn = userId.HasValue && userId.Value > 0;

    //Layout = null; // No layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Browse Comics</title>
    <!-- Tailwind CSS and Material Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/@@material-tailwind/html@latest/styles/material-tailwind.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/@@material-tailwind/html@latest/scripts/script.js"></script>
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-gray-100 min-h-screen">
    <!-- Main Content -->
    <div class="container mx-auto px-4 py-8">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-900">Browse Comics</h1>

        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            @foreach (var comic in Model)
            {
                bool isFollowing = followedComicIds.Contains(comic.ComicId);

                <div class="bg-white rounded-lg overflow-hidden shadow-lg transition-transform hover:scale-105">
                    <a href="@Url.Action("Details", "Comic", new { id = comic.ComicId })" class="block">
                        <img src="@(string.IsNullOrEmpty(comic.ThumbnailUrl) ? "/images/default-comic.jpg" : comic.ThumbnailUrl)"
                             class="w-full h-64 object-cover"
                             alt="@comic.Title" />
                    </a>

                    <div class="p-4">
                        <a href="@Url.Action("Details", "Comic", new { id = comic.ComicId })" class="block">
                            <h3 class="text-xl font-bold mb-2 text-gray-900 hover:text-indigo-600 transition-colors line-clamp-2">
                                @comic.Title
                            </h3>
                        </a>

                        <div class="flex items-center justify-between text-gray-600 mb-3">
                            <span class="inline-flex items-center">
                                <i class="fas fa-eye mr-1"></i>
                                <span>@(comic.ComicStat?.ViewCount?.ToString("N0") ?? "0")</span>
                            </span>
                            <span class="inline-flex items-center">
                                <i class="fas fa-comment mr-1"></i>
                                <span>@(comic.ComicStat?.CommentCount?.ToString("N0") ?? "0")</span>
                            </span>
                            <span class="inline-flex items-center text-pink-500">
                                <i class="fas fa-heart mr-1"></i>
                                <span>@(comic.ComicStat?.FollowCount?.ToString("N0") ?? "0")</span>
                            </span>
                            <span class="inline-flex items-center text-yellow-500">
                                <i class="fas fa-star mr-1"></i>
                                <span>@(ViewBag.ComicRatings[comic.ComicId])</span>
                            </span>
                        </div>

                        <div class="border-t border-gray-200 pt-3">
                            @{
                                var chapters = comic.Chapters?.OrderByDescending(c => c.ChapterNumber).Take(3).ToList() ?? new List<Chapter>();
                            }

                            @if (chapters.Any())
                            {
                                <div class="space-y-2">
                                    @foreach (var chapter in chapters)
                                    {
                                        <a href="@Url.Action("Read", "Chapter", new { id = chapter.ChapterId })"
                                           class="flex justify-between items-center hover:bg-gray-50 px-2 py-1 rounded-md transition-colors">
                                            <span class="text-gray-900">Chapter @chapter.ChapterNumber</span>
                                            @if (chapter.CreatedAt.HasValue)
                                            {
                                                TimeSpan timeAgo = DateTime.Now - chapter.CreatedAt.Value;
                                                string timeText = "";

                                                if (timeAgo.TotalMinutes < 60)
                                                {
                                                    timeText = $"{(int)timeAgo.TotalMinutes} min ago";
                                                }
                                                else if (timeAgo.TotalHours < 24)
                                                {
                                                    timeText = $"{(int)timeAgo.TotalHours} hours ago";
                                                }
                                                else
                                                {
                                                    timeText = $"{(int)timeAgo.TotalDays} days ago";
                                                }

                                                <span class="text-gray-500 text-sm">@timeText</span>
                                            }
                                        </a>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-gray-500 text-center py-2">No chapters yet</p>
                            }
                        </div>
                    </div>

                    @if (isLoggedIn)
                    {
                        <div class="px-4 pb-4">
                            <button class="follow-toggle-btn w-full py-2 rounded-md text-center transition-colors @(isFollowing ? "bg-pink-100 text-pink-700" : "bg-gray-100 text-gray-700") hover:bg-pink-200"
                                    data-comic-id="@comic.ComicId"
                                    data-following="@isFollowing.ToString().ToLower()">
                                <i class="fas @(isFollowing ? "fa-heart" : "fa-heart") mr-2"></i>
                                @(isFollowing ? "Following" : "Follow")
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-white shadow-inner mt-8 py-6">
        <div class="container mx-auto px-4">
            <div class="text-center text-gray-500">
                <p>&copy; @DateTime.Now.Year - NettruyenRemake - Comic Reading Platform</p>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.follow-toggle-btn').click(function() {
                var btn = $(this);
                var comicId = btn.data('comic-id');

                $.ajax({
                    url: '@Url.Action("ToggleFollow", "Comic")',
                    type: 'POST',
                    data: { comicId: comicId },
                    success: function(response) {
                        if (response.success) {
                            if (response.following) {
                                // Update to "following" state
                                btn.html('<i class="fas fa-heart mr-2"></i> Following');
                                btn.removeClass('bg-gray-100 text-gray-700').addClass('bg-pink-100 text-pink-700');
                                btn.data('following', 'true');

                                // Find the heart icon in the stats section and update the count
                                var statElement = btn.closest('.bg-white').find('.text-pink-500');
                                var currentCount = parseInt(statElement.find('span').text().replace(/,/g, ''));
                                statElement.find('span').text((currentCount + 1).toLocaleString());
                            } else {
                                // Update to "not following" state
                                btn.html('<i class="fas fa-heart mr-2"></i> Follow');
                                btn.removeClass('bg-pink-100 text-pink-700').addClass('bg-gray-100 text-gray-700');
                                btn.data('following', 'false');

                                // Find the heart icon in the stats section and update the count
                                var statElement = btn.closest('.bg-white').find('.text-pink-500');
                                var currentCount = parseInt(statElement.find('span').text().replace(/,/g, ''));
                                statElement.find('span').text((Math.max(0, currentCount - 1)).toLocaleString());
                            }
                        } else {
                            alert(response.message || 'Failed to update follow status.');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("AJAX Error:", status, error);
                        console.log("Response:", xhr.responseText);
                        alert('Failed to update follow status. Please try again.');
                    }
                });
            });
        });
    </script>
</body>
</html> 