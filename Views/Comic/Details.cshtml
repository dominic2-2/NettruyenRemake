@model NettruyenRemake.Models.Comic

@{
    ViewData["Title"] = Model.Title;
    bool isFollowing = ViewBag.IsFollowing ?? false;

    // Check if user is logged in using session
    var userId = Context.Session.GetInt32("UserId");
    bool isLoggedIn = userId.HasValue && userId.Value > 0;

    //Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Title</title>
    <!-- Tailwind CSS and Material Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/@@material-tailwind/html@latest/styles/material-tailwind.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/@@material-tailwind/html@latest/scripts/script.js"></script>
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-gray-100 min-h-screen">
    <!-- Main Content -->
    <div class="container mx-auto px-4 py-6">
        <div class="flex flex-col md:flex-row gap-8">
            <!-- Comic Cover and Follow Button -->
            <div class="md:w-1/3">
                <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                    <img src="@(string.IsNullOrEmpty(Model.ThumbnailUrl) ? "/images/default-comic.jpg" : Model.ThumbnailUrl)" 
                         class="w-full h-auto object-cover" alt="@Model.Title">

                    <div class="p-4">
                        @if (isLoggedIn)
                        {
                                <button id="followBtn" 
                                        class="w-full py-3 rounded-md @(isFollowing ? "bg-pink-100 text-pink-700" : "bg-gray-100 text-gray-700") hover:bg-pink-200 transition-colors">
                                    <i class="fas @(isFollowing ? "fa-heart" : "fa-heart") mr-2"></i>
                                @(isFollowing ? "Following" : "Follow This Comic")
                                </button>

                                <!-- Star rating UI moved here, below the follow button -->
                                <div class="mt-4">
                                    <div class="flex items-center space-x-1 justify-center" id="ratingStars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                                <button class="rating-star text-xl @(ViewBag.UserRating >= i ? "text-yellow-400" : "text-gray-300")" 
                                                        data-rating="@i">
                                                    <i class="fas fa-star"></i>
                                                </button>
                                    }
                                    </div>
                                    <p class="text-xs text-gray-500 mt-1 text-center">
                                    @if (ViewBag.UserRating > 0)
                                    {
                                                <span>Your rating: <span id="userRatingText">@ViewBag.UserRating</span></span>
                                    }
                                    else
                                    {
                                                <span id="userRatingText">Click to rate</span>
                                    }
                                    </p>
                                </div>
                        }
                        else
                        {
                                <a href="@Url.Action("Login", "Authen", new { returnUrl = Url.Action("Details", "Comic", new { id = Model.ComicId }) })" 
                                   class="block w-full py-3 text-center bg-indigo-600 text-white rounded-md shadow hover:bg-indigo-700 transition-colors">
                                    <i class="fas fa-sign-in-alt mr-2"></i> Login to Follow
                                </a>
                        }

                        <!-- Comic Stats -->
                        <div class="mt-4 space-y-2">
                            <div class="flex justify-between items-center">
                                <span class="text-gray-700">Status:</span>
                                <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">@Model.Status.StatusName</span>
                            </div>

                            <div class="flex justify-between items-center">
                                <span class="text-gray-700">Views:</span>
                                <span id="viewCount" class="font-medium">@(Model.ComicStat?.ViewCount?.ToString("N0") ?? "0")</span>
                            </div>

                            <div class="flex justify-between items-center">
                                <span class="text-gray-700">Follows:</span>
                                <span id="followCount" class="font-medium">@(Model.ComicStat?.FollowCount?.ToString("N0") ?? "0")</span>
                            </div>

                            <div class="flex justify-between items-center">
                                <span class="text-gray-700">Comments:</span>
                                <span class="font-medium">@(Model.ComicStat?.CommentCount?.ToString("N0") ?? "0")</span>
                            </div>

                            <div class="flex justify-between items-center">
                                <span class="text-gray-700">Author:</span>
                                <span class="font-medium">@(Model.Author ?? "Unknown")</span>
                            </div>
                        </div>

                        <!-- Add this inside your comic stats section -->
                        <div class="flex items-center text-yellow-500 mb-2">
                            <i class="fas fa-star mr-1"></i>
                            <span id="avgRating">@ViewBag.AverageRating</span>
                            <span class="text-gray-500 text-sm ml-1">(@ViewBag.RatingCount ratings)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Comic Details and Chapters -->
            <div class="md:w-2/3">
                <h1 class="text-3xl font-bold text-gray-900 mb-4">@Model.Title</h1>

                <!-- Description -->
                <div class="bg-white rounded-lg shadow-lg p-6 mb-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-3">Description</h2>
                    <div class="prose max-w-none text-gray-700">
                        @if (string.IsNullOrEmpty(Model.Description))
                        {
                                <p class="italic text-gray-500">No description available for this comic.</p>
                        }
                        else
                        {
                                <div class="description-container">
                                    <div class="description-content overflow-hidden transition-all duration-300" style="max-height: 100px;">
                                        <p>@Model.Description</p>
                                    </div>
                                    <button id="description-toggle" class="mt-2 text-indigo-600 hover:text-indigo-800 text-sm font-medium flex items-center">
                                        <span>Show More</span>
                                        <i class="fas fa-chevron-down ml-1 text-xs transition-transform duration-300"></i>
                                    </button>
                                </div>
                        }
                    </div>
                </div>

                <!-- Chapters -->
                <div class="bg-white rounded-lg shadow-lg p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-3">Chapters</h2>
                    @if (!Model.Chapters.Any())
                    {
                            <p class="italic text-gray-500">No chapters available yet.</p>
                    }
                    else
                    {
                            <div class="space-y-1">
                            @foreach (var chapter in Model.Chapters.OrderByDescending(c => c.ChapterNumber))
                            {
                                        <a href="@Url.Action("Read", "Chapter", new { id = chapter.ChapterId })" 
                                           class="flex justify-between items-center p-3 hover:bg-gray-50 rounded-md transition-colors">
                                            <span class="text-indigo-600 font-medium">
                                                Chapter @chapter.ChapterNumber
                                        @if (!string.IsNullOrEmpty(chapter.Title))
                                        {
                                                        <span class="text-gray-700 font-normal"> - @chapter.Title</span>
                                        }
                                            </span>
                                            <span class="text-gray-500 text-sm">
                                        @(chapter.CreatedAt.HasValue ? chapter.CreatedAt.Value.ToString("MMM dd, yyyy") : "")
                                            </span>
                                        </a>
                            }
                            </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-white shadow-inner mt-8 py-6">
        <div class="container mx-auto px-4">
            <div class="text-center text-gray-500">
                <p>&copy; @DateTime.Now.Year - NettruyenRemake - Comic Reading Platform</p>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
    $(document).ready(function() {
        $('#followBtn').click(function() {
            var btn = $(this);
            var isFollowing = btn.hasClass('bg-pink-100');

            $.ajax({
                url: '@Url.Action("ToggleFollow", "Comic")',
                type: 'POST',
                data: { comicId: @Model.ComicId },
                success: function(response) {
                    if (response.success) {
                        if (response.following) {
                            // Update to "following" state
                            btn.html('<i class="fas fa-heart mr-2"></i> Following');
                            btn.removeClass('bg-gray-100 text-gray-700').addClass('bg-pink-100 text-pink-700');

                            // Update follow count
                            var currentCount = parseInt($('#followCount').text().replace(/,/g, ''));
                            $('#followCount').text((currentCount + 1).toLocaleString());
                        } else {
                            // Update to "not following" state
                            btn.html('<i class="fas fa-heart mr-2"></i> Follow This Comic');
                            btn.removeClass('bg-pink-100 text-pink-700').addClass('bg-gray-100 text-gray-700');

                            // Update follow count
                            var currentCount = parseInt($('#followCount').text().replace(/,/g, ''));
                            $('#followCount').text(Math.max(0, currentCount - 1).toLocaleString());
                        }
                    } else {
                        alert(response.message || 'Failed to update follow status.');
                    }
                },
                error: function(xhr, status, error) {
                    console.error("AJAX Error:", status, error);
                    console.log("Response:", xhr.responseText);
                    alert('Failed to update follow status. Please try again.');
                }
            });
        });

        // Description toggle
        $('#description-toggle').click(function() {
            var container = $('.description-content');
            var button = $(this);
            var icon = button.find('i');

            if (container.css('max-height') === '100px') {
                // Expand
                container.css('max-height', container[0].scrollHeight + 'px');
                button.find('span').text('Show Less');
                icon.addClass('rotate-180');
            } else {
                // Collapse
                container.css('max-height', '100px');
                button.find('span').text('Show More');
                icon.removeClass('rotate-180');
            }
        });

        // Rating stars functionality
        $('.rating-star').hover(
            function() {
                var rating = $(this).data('rating');
                // On hover, highlight this star and all previous stars
                $('.rating-star').each(function() {
                    if ($(this).data('rating') <= rating) {
                        $(this).addClass('text-yellow-400').removeClass('text-gray-300');
                    } else {
                        $(this).addClass('text-gray-300').removeClass('text-yellow-400');
                    }
                });
            },
            function() {
                // On mouseout, restore original state based on user's rating
                var userRating = parseInt($('#userRatingText').text()) || 0;
                $('.rating-star').each(function() {
                    if ($(this).data('rating') <= userRating) {
                        $(this).addClass('text-yellow-400').removeClass('text-gray-300');
                    } else {
                        $(this).addClass('text-gray-300').removeClass('text-yellow-400');
                    }
                });
            }
        );

        $('.rating-star').click(function() {
            var ratingValue = $(this).data('rating');

            $.ajax({
                url: '@Url.Action("RateComic", "Comic")',
                type: 'POST',
                data: { 
                    comicId: @Model.ComicId, 
                    rating: ratingValue 
                },
                success: function(response) {
                    if (response.success) {
                        // Store the rating value
                        var savedRating = ratingValue;

                        // Update the average rating display
                        $('#avgRating').text(response.averageRating);
                        $('#userRatingText').text(savedRating);

                        // Update the star highlighting to match the saved rating
                        updateStarDisplay(savedRating);

                        // Show a success message
                        alert('Your rating has been saved!');
                    } else {
                        alert(response.message || 'Failed to save rating. Please try again.');
                    }
                },
                error: function(xhr, status, error) {
                    console.error("AJAX Error:", status, error);
                    console.log("Response:", xhr.responseText);
                    alert('Failed to save rating. Please try again.');
                }
            });
        });

        // Helper function to update star display based on rating
        function updateStarDisplay(rating) {
            $('.rating-star').each(function() {
                if ($(this).data('rating') <= rating) {
                    $(this).addClass('text-yellow-400').removeClass('text-gray-300');
                } else {
                    $(this).addClass('text-gray-300').removeClass('text-yellow-400');
                }
            });
        }

        // Initialize stars on page load
        var initialRating = parseInt($('#userRatingText').text()) || 0;
        updateStarDisplay(initialRating);
    });
    </script>


</body>
</html> 