<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active</title>
    <!-- Import Material Tailwind CSS -->
    <link href="https://cdn.jsdelivr.net/npm/@@material-tailwind/html@latest/styles/material-tailwind.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#2196f3',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-100 min-h-screen m-0">
    <!-- Main Section -->
    <main class="flex items-center justify-center min-h-screen pt-16">
        <div class="w-full max-w-md mx-auto p-6">
            <div class="bg-white rounded-lg shadow-lg p-6">
                <h3 class="text-2xl font-bold text-gray-800 mb-4 text-center">Activate Your Account</h3>

                <!-- Message Display -->
                @if (ViewBag.msg != null)
                {
                    <div class="mb-4 p-3 bg-blue-100 text-blue-700 rounded-lg">
                        @ViewBag.msg
                    </div>
                }

                <!-- Form -->
                <form method="post" asp-controller="account" asp-action="active" class="space-y-6">
                    <div>
                        <label for="securityCode" class="block text-sm font-medium text-gray-700 mb-1">
                            Security Code
                        </label>
                        <input type="text"
                               name="securityCode"
                               id="securityCode"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                               placeholder="Enter security code"
                               required>
                    </div>

                    <div class="flex justify-between gap-4">
                        <button type="submit"
                                class="w-full px-4 py-2 bg-primary hover:bg-blue-700 text-white font-medium rounded-md transition duration-200">
                            Activate
                        </button>
                        <a href="@Url.Action("resend", "account")"
                           class="w-full px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white font-medium rounded-md transition duration-200 text-center flex items-center justify-center">
                            Resend
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>
</html>