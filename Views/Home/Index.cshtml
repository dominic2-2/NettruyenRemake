    <!-- JavaScript for Carousel -->
    <script>
        function scrollCarousel(carouselId, direction) {
            const carousel = document.getElementById(carouselId);
            const itemWidth = carousel.querySelector('div').offsetWidth + 24; // 24 là space-x-6
            const itemsPerView = 4; // Số mục hiển thị trên màn hình
            const maxScroll = carousel.scrollWidth - carousel.clientWidth;

            let currentScroll = carousel.scrollLeft;
            let scrollAmount = currentScroll + (direction * itemWidth * itemsPerView);

            // Nếu cuộn tới cuối (hướng phải), quay lại đầu
            if (scrollAmount > maxScroll) {
                scrollAmount = 0; // Quay lại đầu carousel
            }
            // Nếu cuộn tới đầu (hướng trái), chuyển tới cuối
            else if (scrollAmount < 0) {
                scrollAmount = maxScroll; // Chuyển tới cuối carousel
            }

            carousel.scrollTo({
                left: scrollAmount,
                behavior: 'smooth'
            });
        }
    </script>

    <!-- JavaScript for Carousel -->
    <script>
        function scrollCarousel(carouselId, direction) {
            const carousel = document.getElementById(carouselId);
            if (!carousel) return; // Kiểm tra nếu carousel không tồn tại

            const itemWidth = carousel.querySelector('div').offsetWidth + 24; // 24 là space-x-6
            const itemsPerView = 4; // Số mục hiển thị trên màn hình
            const maxScroll = carousel.scrollWidth - carousel.clientWidth;

            let currentScroll = carousel.scrollLeft;
            // Đảo ngược direction: direction * -1
            let scrollAmount = currentScroll + (direction * -1 * itemWidth * itemsPerView);

            // Nếu cuộn tới cuối (hướng phải), quay lại đầu
            if (scrollAmount > maxScroll) {
                scrollAmount = 0; // Quay lại đầu carousel
            }
            // Nếu cuộn tới đầu (hướng trái), chuyển tới cuối
            else if (scrollAmount < 0) {
                scrollAmount = maxScroll; // Chuyển tới cuối carousel
            }

            carousel.scrollTo({
                left: scrollAmount,
                behavior: 'smooth'
            });
        }
    </script>
    }
